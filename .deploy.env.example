# 复制为 .deploy.env 后填写。切勿提交到 git（.gitignore 已忽略 .dev.vars / .env，请自行确认本文件也不入库）
# 变量会被 deploy.sh 读取；命令行已 export 的同名变量优先级更高。

# ---- Cloudflare 凭据 ----
# 需要权限：Workers Scripts:Edit / D1:Edit / Workers R2 Storage:Edit / Workers KV Storage:Edit / Queues:Edit
CF_API_TOKEN=
CF_ACCOUNT_ID=

# ---- 站点 ----
SITE_URL=https://b2b.example.com
WORKER_NAME=cf-b2b-pro
D1_NAME=b2b_database
R2_NAME=b2b-product-images
KV_NAME=STATIC_ASSETS
QUEUE_NAME=b2b-inquiry-mail
DLQ_NAME=b2b-inquiry-mail-dlq

# ---- 邮件（Resend）----
# 发件域名必须在 Resend 验证过，并配好 SPF / DKIM / DMARC
# 注意：值里有空格或 < > 时必须加引号，否则 source 这份文件会被当成 shell 重定向
MAIL_TO="sales@example.com"
MAIL_FROM="B2B Inquiry <notify@example.com>"
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# ---- Turnstile ----
# Sitekey 是公开值；Secret 只写进 Worker secret
TURNSTILE_SITEKEY=
TURNSTILE_SECRET_KEY=

# ---- 安全 ----
# 生成方式：openssl rand -hex 32
JWT_SECRET=

# ---- 初始超级管理员（留空则需手动跑 scripts/reset-admin.mjs）----
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
